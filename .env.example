# Copy to .env for local `netlify dev` — also set these in Netlify Dashboard → Environment variables

# WAJIB untuk mode API (default) — dapatkan di https://muapi.ai
MUAPI_API_KEY=your_muapi_key_here
MUAPI_BASE_URL=https://api.muapi.ai
MUAPI_POLL_INTERVAL=5000
MUAPI_POLL_TIMEOUT=1800000

# Untuk mode Local (opsional — diteruskan ke pipeline lokal jika kamu host sendiri)
LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_key_here
GEMINI_API_KEY=your_gemini_key_here
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-2.5-flash
